        <script>
        document.addEventListener('DOMContentLoaded', () => {
            // 3D Glass Bucket Chips Auto-Rotation
            let activeIndex = 0;
            const chips = [
                document.getElementById('chip-1'),
                document.getElementById('chip-2'),
                document.getElementById('chip-3'),
                document.getElementById('chip-4')
            ];

            const rotateChips = () => {
                const prevIndex = activeIndex;
                activeIndex = (activeIndex + 1) % chips.length;
                
                chips.forEach((chip, idx) => {
                    if (idx === activeIndex) {
                        chip.className = 'bucket-chip state-active';
                    } else if (idx === prevIndex) {
                        chip.className = 'bucket-chip state-exit';
                    } else {
                        chip.className = 'bucket-chip state-enter';
                    }
                });
            };

            // Initialize states
            chips.forEach((chip, idx) => {
                if (idx === 0) {
                    chip.className = 'bucket-chip state-active';
                } else {
                    chip.className = 'bucket-chip state-enter';
                }
            });

            // Rotate every 2.5 seconds
            setInterval(rotateChips, 2500);
        });
        </script>
