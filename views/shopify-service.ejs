        <script>
        function toggleAccordion(itemId) {
            const items = document.querySelectorAll('.luxury-accordion-item');
            
            items.forEach(item => {
                const content = item.querySelector('.luxury-accordion-content');
                if (item.id === itemId) {
                    const isActive = item.classList.contains('active');
                    if (isActive) {
                        item.classList.remove('active');
                        content.style.maxHeight = '0';
                    } else {
                        item.classList.add('active');
                        content.style.maxHeight = content.scrollHeight + 'px';
                    }
                } else {
                    item.classList.remove('active');
                    content.style.maxHeight = '0';
                }
            });
        }

        // Initialize first item heights on load
        window.addEventListener('DOMContentLoaded', () => {
            const activeContent = document.querySelector('.luxury-accordion-item.active .luxury-accordion-content');
            if (activeContent) {
                activeContent.style.maxHeight = activeContent.scrollHeight + 'px';
            }
        });
        </script>
