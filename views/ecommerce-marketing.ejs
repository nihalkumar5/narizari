    const icon = btn.querySelector('.struggle-faq-icon');
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    const allItems = document.querySelectorAll('.struggle-faq-trigger');

    allItems.forEach(function(b) {
        const bId = b.getAttribute('aria-controls');
        const bBody = document.getElementById(bId);
        const bIcon = b.querySelector('.struggle-faq-icon');
        b.setAttribute('aria-expanded', 'false');
        if (bBody) {
            bBody.style.maxHeight = '0px';
            setTimeout(function() { if (b.getAttribute('aria-expanded') === 'false') bBody.hidden = true; }, 400);
        }
        if (bIcon) bIcon.style.transform = 'rotate(0deg)';
    });

    if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        body.hidden = false;
        requestAnimationFrame(function() {
            body.style.maxHeight = body.scrollHeight + 'px';
        });
        if (icon) icon.style.transform = 'rotate(45deg)';
    }
}
</script>

