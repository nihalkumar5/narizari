<style>
/* CSS Variable overrides to map Jägerhof styling variables to Narizari Burgundy & Gold */
:root {
  /* Override Lumos color theme variables */
  --_theme---background: transparent !important;
  --_theme---text: #E5E5E5 !important;
  --_theme---text-secondary: rgba(229, 229, 229, 0.7) !important;
  --_theme---border: rgba(255, 255, 255, 0.1) !important;
  --_theme---selection--background: #A68D6A !important;
  --_theme---selection--text: #24090D !important;

  /* Swatches overrides */
  --swatch--pine: #A68D6A !important; /* Gold accent */
  --swatch--off-white: #E5E5E5 !important;
  --swatch--white: #FFFFFF !important;
  --swatch--clay: #351015 !important; /* Deep Burgundy/Maroon */
  --swatch--charcoal: #E5E5E5 !important;
  --_button-style---text-hover: #24090D !important;
}

/* Page spacing below fixed nav bar */
.page_main {
  padding-top: 130px !important;
  background: transparent !important;
}

.u-section {
  background-color: transparent !important;
}

/* Typography matching Varanasi Silk AI brand identity */
h1, h2, h3, h4, h5, h6, .u-text-style-h1, .u-text-style-h5, .u-heading-accent {
  font-family: 'Cormorant Garamond', 'Outfit', serif !important;
  font-weight: 300 !important;
  letter-spacing: 0.02em !important;
}

body, p, .u-text-style-main, .u-rich-text, .legal_text, .layout_2-col_text_wrap, .slide_text {
  font-family: 'Inter', sans-serif !important;
  font-weight: 300 !important;
  line-height: 1.75 !important;
  color: rgba(229, 229, 229, 0.8) !important;
}

/* Highlight important terms in gold */
strong, b {
  font-weight: 600 !important;
  color: var(--accent-gold) !important;
}

.layout_2-col_title {
  color: #FFFFFF !important;
  font-size: clamp(32px, 4vw, 56px) !important;
}

/* Button & interactive animations */
.button_main_wrap {
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  background: rgba(255, 255, 255, 0.03) !important;
  border-radius: 30px !important;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

.button_main_wrap:hover {
  background: var(--accent-gold) !important;
  border-color: var(--accent-gold) !important;
}

.button_main_wrap:hover .button_main_text {
  color: #24090D !important;
}

.button_main_text {
  color: #FFFFFF !important;
  font-weight: 600 !important;
  letter-spacing: 0.1em !important;
}

/* Clean, non-distracting visual overlays */
.layout_2-col_content {
  background: transparent !important;
}

/* Sustainability card styling custom adjustments */
.card_grow_wrap {
  border: 1px solid rgba(255, 255, 255, 0.06) !important;
  border-radius: 40px !important;
  background: rgba(255, 255, 255, 0.02) !important;
  backdrop-filter: blur(20px) !important;
  margin: 100px auto !important;
  max-width: 1200px !important;
}

/* Custom hides for unnecessary Jägerhof elements */
.u-position-fixed, .guide_wrap, .nav_component, .transition_wrap, .nav_background {
  display: none !important;
}

/* Hide scrollbar completely to match parent styles */
body ::-webkit-scrollbar { display: none; }
body { -ms-overflow-style: none; }
html { scrollbar-width: none; }

</style>
