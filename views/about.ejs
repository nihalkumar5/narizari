ariant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div></section><section id="" data-grow-wrap="" class="card_grow_wrap u-section"><div data-grow-visual="" class="card_grow_visual u-cover-absolute"><div data-wf--media-overlay--variant="base" class="u-overlay u-zindex-1" data-number="60" data-grow-overlay=""></div><div data-wf--visual-image--variant="cover" class="u-image-wrapper w-variant-4972adff-107c-1f37-d19c-526a2bf55c28" STYLE="" data-grow-image=""><img src="https://cdn.prod.website-files.com/68f600e7f8352629c0b73507/6919b1c0ada11f240d9d8fbb_DSCF0629%20(1).avif" loading="lazy" width="Auto" alt="Mauer aus moosbedeckten Steinen im Wald bei Sonnenlicht neben einem Baumstamm." sizes="(max-width: 3384px) 100vw, 3384px" srcset="https://cdn.prod.website-files.com/68f600e7f8352629c0b73507/6919b1c0ada11f240d9d8fbb_DSCF0629%20(1)-p-500.avif 500w, https://cdn.prod.website-files.com/68f600e7f8352629c0b73507/6919b1c0ada11f240d9d8fbb_DSCF0629%20(1)-p-800.avif 800w, https://cdn.prod.website-files.com/68f600e7f8352629c0b73507/6919b1c0ada11f240d9d8fbb_DSCF0629%20(1).avif 1000w" class="u-image"/></div></div><div class="card_grow_contain u-container"><div data-grow-content="" class="card_grow_content u-theme-dark u-alignment-center"><div data-wf--spacer--section-space="large" class="u-section-spacer w-variant-8cc18b30-4618-8767-0111-f6abfe45aaa3 u-ignore-trim"></div><div data-fade-in="false" data-split-heading="false" data-number="40" data-wf--typography-heading--font-style="h5" class="u-text w-variant-326a9562-3263-06da-e8ef-16981fd70f1c w-richtext u-margin-bottom-6"><h2><strong>Responsibility from Conviction</strong></h2></div><div data-fade-in="false" data-split-heading="false" data-number="20" data-wf--typography-heading--font-style="h1" class="u-text w-variant-792802b6-ccdb-f982-5023-5fa970cf03d0 w-richtext u-heading-accent"><p>Our Commitment to Sustainability</p></div><div data-fade-in="false" data-number="33" data-wf--typography-paragraph--font-style="text-main" 