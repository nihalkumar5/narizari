    <script>
    function toggleFaq(btn) {
        const bodyId = btn.getAttribute('aria-controls');
        const body = document.getElementById(bodyId);
        const icon = btn.querySelector('.struggle-faq-icon svg');
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        const allItems = document.querySelectorAll('.struggle-faq-trigger');

        // Close all
        allItems.forEach(function(b) {
            const bId = b.getAttribute('aria-controls');
            const bBody = document.getElementById(bId);
            const bIcon = b.querySelector('.struggle-faq-icon svg');
            b.setAttribute('aria-expanded', 'false');
            b.closest('.struggle-faq-item').classList.remove('is-open');
            if (bBody) {
                bBody.style.maxHeight = '0px';
                setTimeout(function() { if (b.getAttribute('aria-expanded') === 'false') bBody.hidden = true; }, 400);
            }
            if (bIcon) bIcon.style.transform = 'rotate(0deg)';
        });

        // Open clicked (if it was closed)
        if (!isOpen) {
            btn.setAttribute('aria-expanded', 'true');
            btn.closest('.struggle-faq-item').classList.add('is-open');
            body.hidden = false;
            requestAnimationFrame(function() {
                body.style.maxHeight = body.scrollHeight + 'px';
            });
            if (icon) icon.style.transform = 'rotate(45deg)';
        }
    }
    </script>

