    <script>
    (function() {
        var steps = document.querySelectorAll('.egf-step-v2');
        if (!steps.length) return;

        // Scroll-triggered reveals
        var obs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) { e.target.classList.add('egf-in'); obs.unobserve(e.target); }
            });
        }, { threshold: 0.2 });
        steps.forEach(function(s) { obs.observe(s); });

        // Mouse-tracking shimmer on cards
        document.querySelectorAll('.egf-card-v2-inner').forEach(function(card) {
            card.addEventListener('mousemove', function(e) {
                var r = card.getBoundingClientRect();
                card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
                card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
            });
        });

        // SVG line draw on scroll
        var line = document.querySelector('.egf-timeline-path');
        var wrap = document.querySelector('.egf-flow-wrap');
        if (!line || !wrap) return;

        function drawLine() {
            var r = wrap.getBoundingClientRect();
            var p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (r.height + window.innerHeight * 0.4)));
            line.style.setProperty('--scroll-p', (p * 100) + '%');
        }
        window.addEventListener('scroll', drawLine, { passive: true });
        drawLine();

        // Node hover glow
        document.querySelectorAll('.egf-node-v2').forEach(function(node) {
            node.addEventListener('mouseenter', function() { node.classList.add('egf-node-hover'); });
            node.addEventListener('mouseleave', function() { node.classList.remove('egf-node-hover'); });
        });
    })();
    </script>

