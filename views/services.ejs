<%- include('partials/header') %>

<main class="section-padding">
    <div class="container">
        
        <!-- Header -->
        <div class="reveal" style="text-align: center; margin-bottom: 80px;">
            <p class="hero-tagline">• THE DIGITAL RETAILED LOOM</p>
            <h1 class="page-main-title">Crafting the Future of <span class="masked">Varanasi Silk</span></h1>
            <div class="page-intro" style="margin-left: auto; margin-right: auto; text-align: center;">
                <p>We provide an end-to-end luxury e-commerce and performance marketing ecosystem built exclusively for premium Saree & Ethnicwear brands. From the weaver's loom to the international customer's doorstep, we weave digital excellence into every step.</p>
            </div>
        </div>

        <!-- Detailed Services Grid -->
        <div style="margin-bottom: 120px;">
            <!-- Service 1: eCommerce & Marketing -->
            <section class="reveal" id="silk-suite" style="padding: 60px 0 100px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); margin-bottom: 80px;">
                <!-- Intro Row -->
                <div class="detailed-service-row" style="border: none; padding: 0; margin-bottom: 80px;">
                    <div class="service-info">
                        <span class="service-index">01</span>
                        <h2>eCommerce & Marketing</h2>
                        <h3>Full-Suite Tactical Co-Pilot</h3>
                        
                        <p style="font-size: 17px; line-height: 1.6; color: rgba(255, 255, 255, 0.85); margin-bottom: 25px;">
                            Let’s be honest—running an eCommerce brand is no small gig. It’s like running a mini empire (just without the crown). It’s product uploads, campaign launches, SEO checklists, email flows, analytics deep-dives, and answering customer queries before your coffee kicks in.
                        </p>
                        <p style="font-size: 16px; color: var(--accent-gold); font-weight: 600; margin-bottom: 25px; letter-spacing: 0.05em;">
                            Sound familiar? We’ve got you.
                        </p>
                        <p style="font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.6);">
                            At <strong>Narizari</strong>, we take the pressure off your plate so you can focus on what you actually want to be doing—building your brand, creating magic, and celebrating wins.
                        </p>
                    </div>
                    
                    <div class="service-visual" style="display: flex; align-items: center; justify-content: center;">
                        <div class="glass-box" style="padding: 50px 40px; text-align: center; background: linear-gradient(135deg, rgba(166,141,106,0.05) 0%, rgba(37,9,14,0.4) 100%); border-radius: 40px; height: auto; border: 1px solid rgba(166,141,106,0.15); width: 100%;">
                            <span class="option-icon" style="font-size: 56px; display: block; margin-bottom: 20px;">🛡️</span>
                            <h4 style="font-size: 22px; font-weight: 300; line-height: 1.4; color: white; font-family: 'Outfit', sans-serif;">Your eCommerce Co-Pilot</h4>
                            <p style="font-size: 14px; color: rgba(255,255,255,0.6); margin-top: 15px; line-height: 1.6;">
                                We quietly steer the backend and handle the day-to-day so you can scale without the scramble.
                            </p>
                            <div style="margin-top: 30px; height: 1px; background: rgba(255,255,255,0.08); width: 100%;"></div>
                            <p style="font-size: 13px; color: var(--accent-gold); margin-top: 25px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase;">
                                Let’s build something that sells—and sticks.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- 6 Pillars Grid -->
                <div style="margin-top: 50px;">
                    <h4 class="reveal" style="font-size: 12px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent-gold); text-align: center; margin-bottom: 50px;">Here’s what our full-suite support looks like</h4>
                    
                    <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
                        
                        <!-- Card 1 -->
                        <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                            <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 01</span>
                            <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Platform & Catalog Management</h3>
                            <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                                From keeping product listings neat and keyword-rich to syncing inventory across channels—we’ve got your backend organised and running like clockwork. New launch? We’ll make it shine before it even hits the homepage.
                            </p>
                        </div>

                        <!-- Card 2 -->
                        <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                            <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 02</span>
                            <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">SEO & Site Optimization</h3>
                            <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                                Visibility is everything. We fine-tune your site so it ranks higher, loads faster, and keeps users engaged longer. From keywords to UX—we don’t just boost traffic, we keep it converting.
                            </p>
                        </div>

                        <!-- Card 3 -->
                        <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                            <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 03</span>
                            <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Performance Marketing & Campaign Execution</h3>
                            <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                                No throwing money into the ad void here. We create campaigns with strategy and style—targeted, creative, and results-driven. Meta, Google, influencers—we know where your audience lives and how to grab their attention.
                            </p>
                        </div>

                        <!-- Card 4 -->
                        <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                            <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 04</span>
                            <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Social Media & Content Management</h3>
                            <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                                We build scroll-stopping content with a purpose. Your tone, your aesthetic, our strategic edge. Whether it’s reels, captions, or blog posts—we tell your brand story and keep the conversation going.
                            </p>
                        </div>

                        <!-- Card 5 -->
                        <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                            <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 05</span>
                            <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Analytics, Reporting & Growth Insights</h3>
                            <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                                No more data overload. We break it all down into what you need to know, why it matters, and what to do next. Simple, smart, and always actionable.
                            </p>
                        </div>

                        <!-- Card 6 -->
                        <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                            <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 06</span>
                            <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Customer Experience & Support Advisory</h3>
                            <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                                From the first click to the follow-up email, we help shape customer journeys that leave a lasting impression. We’re here to help turn shoppers into superfans.
                            </p>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Service 2 -->
            <section class="detailed-service-row reverse reveal" id="intelligent-marketing">
                <div class="service-info">
                    <span class="service-index">02</span>
                    <h2>Intelligent Marketing</h2>
                    <h3>Precision Growth & High-ROAS Performance</h3>
                    <p>Using proprietary audience segment modeling, we connect heritage weavers and boutique designers with premium buyers. Our campaigns target the high-ticket bridal and festive markets with extreme accuracy, eliminating wasted ad spend.</p>
                    <ul class="luxury-check-list">
                        <li>AI-Driven Social & Search Campaigns</li>
                        <li>Bridal & Festive Audience Targeting</li>
                        <li>VIP WhatsApp & Email Automations</li>
                        <li>Verified 12x+ Revenue Return (ROAS)</li>
                    </ul>
                </div>
                <div class="service-visual">
                    <div class="glass-box" style="padding: 40px; text-align: center;">
                        <div class="stat-circle" style="color: var(--accent-gold); font-size: 72px;">12x+</div>
                        <p class="stat-desc" style="font-size: 11px; letter-spacing: 0.15em; color: white;">Average Return on Advertising</p>
                    </div>
                </div>
            </section>

            <!-- Service 3 -->
            <section class="detailed-service-row reveal" id="creative-couture">
                <div class="service-info">
                    <span class="service-index">03</span>
                    <h2>Creative Couture</h2>
                    <h3>Cinematic Branding & Narrative</h3>
                    <p>Every hand-woven saree is a masterpiece. We treat your brand assets with the same meticulous care. Our team organizes cinematic photoshoots and editorial videos directly in Varanasi, telling the emotional stories of the handloom masters.</p>
                    <ul class="luxury-check-list">
                        <li>Cinematic Film Shoots in Varanasi</li>
                        <li>Brand Identity & Logo DNA</li>
                        <li>Premium Unboxing & Packaging Design</li>
                        <li>Editorial Narrative Writing</li>
                    </ul>
                </div>
                <div class="service-visual">
                    <div class="glass-box video-placeholder" style="padding: 40px; text-align: center;">
                        <span class="option-icon" style="font-size: 64px;">🎬</span>
                        <h4 style="font-size: 18px; color: white; margin-top: 15px; text-transform: uppercase; letter-spacing: 0.1em;">Heritage Storytelling</h4>
                        <p style="font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 5px;">Capturing the soul of Banarasi weaving.</p>
                    </div>
                </div>
            </section>
        </div>

        <!-- "How We Weave" Timeline Section -->
        <div class="reveal" style="text-align: center; margin-top: 150px; margin-bottom: 50px;">
            <span class="section-label">• THE METHODOLOGY</span>
            <h2 class="section-title" style="margin-top: 15px;">How We Weave Your Growth</h2>
            <p style="color: var(--text-secondary); max-width: 600px; margin: 0 auto; font-size: 15px;">Our modular, transparent four-step pipeline transforms raw digital channels into luxurious scaling machines.</p>
        </div>

        <div class="timeline-vertical reveal">
            <!-- Step 1 -->
            <div class="timeline-node">
                <div class="timeline-dot"></div>
                <div class="timeline-content left">
                    <span class="timeline-meta">Phase 01</span>
                    <h4>Researching the Loom (Brand Audit)</h4>
                    <p>We perform deep competitive analyses, website speed audits, and study your unique collection DNA to identify exact global bottlenecks and high-performing hooks.</p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="timeline-node">
                <div class="timeline-dot"></div>
                <div class="timeline-content right">
                    <span class="timeline-meta">Phase 02</span>
                    <h4>Spinning the Thread (Strategy Design)</h4>
                    <p>We outline high-converting UI landing flows, construct editorial storytelling narratives, and program AI-modeled targeting scripts customized for high-value bridal buyers.</p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="timeline-node">
                <div class="timeline-dot"></div>
                <div class="timeline-content left">
                    <span class="timeline-meta">Phase 03</span>
                    <h4>Weaving the Pattern (Campaign Launch)</h4>
                    <p>We deploy high-end bespoke Shopify setups, push premium cinematic ad campaigns live, and launch high-ticket VIP WhatsApp triggers for instant engagement.</p>
                </div>
            </div>

            <!-- Step 4 -->
            <div class="timeline-node">
                <div class="timeline-dot"></div>
                <div class="timeline-content right">
                    <span class="timeline-meta">Phase 04</span>
                    <h4>Presenting the Silk (Scale & Optimize)</h4>
                    <p>Continuous scaling, rapid split-testing, and real-time optimization of funnel metrics to push your brand toward stable, high-revenue global benchmarks.</p>
                </div>
            </div>
        </div>

        <!-- Tiered Models / Collaboration Tiers -->
        <div class="reveal" style="text-align: center; margin-top: 150px; margin-bottom: 60px;">
            <span class="section-label">• ENGAGEMENT MODELS</span>
            <h2 class="section-title" style="margin-top: 15px;">Tailored Tiers of Transformation</h2>
            <p style="color: var(--text-secondary); max-width: 600px; margin: 0 auto; font-size: 15px;">Choose the scale of digital architecture that matches your brand's global ambition.</p>
        </div>

        <div class="services-grid reveal" style="margin-bottom: 120px;">
            <!-- Tier 1 -->
            <div class="service-card">
                <span class="service-no">TIER 01</span>
                <h3>The Handloom Scale</h3>
                <p>Designed for traditional looms and local Varanasi boutique operations seeking direct global scaling foundations.</p>
                <ul class="service-list" style="margin-bottom: 40px;">
                    <li>Bespoke Shopify Store Setup</li>
                    <li>Core Facebook/Google Ad Launches</li>
                    <li>Basic Email Automations</li>
                    <li>Bi-Weekly Consulting Reports</li>
                </ul>
                <div style="text-align: center; position: absolute; bottom: 40px; left: 0; width: 100%; padding: 0 40px;">
                    <a href="/book-now" class="btn-reserve" style="width: 100%;">APPLY TO TIER 1</a>
                </div>
            </div>

            <!-- Tier 2 -->
            <div class="service-card" style="border-color: rgba(166,141,106,0.3); background: rgba(166,141,106,0.03);">
                <span class="service-no" style="color: var(--accent-gold); opacity: 1;">★ RECOMMEND TIER 02</span>
                <h3>The D2C Growth Engine</h3>
                <p>For scaling boutique saree collections and mid-market ethnicwear brands seeking rapid digital expansion.</p>
                <ul class="service-list" style="margin-bottom: 40px;">
                    <li>Custom Premium Shopify Theme Design</li>
                    <li>High-ROAS AI-Modeled Ad Campaigns</li>
                    <li>High-Ticket VIP WhatsApp Setup</li>
                    <li>Weekly Optimization and Live Dashboards</li>
                </ul>
                <div style="text-align: center; position: absolute; bottom: 40px; left: 0; width: 100%; padding: 0 40px;">
                    <a href="/book-now" class="btn-reserve" style="width: 100%; background: var(--accent-gold); color: var(--brand-burgundy);">APPLY TO TIER 2</a>
                </div>
            </div>

            <!-- Tier 3 -->
            <div class="service-card">
                <span class="service-no">TIER 03</span>
                <h3>Supreme Silk Monopoly</h3>
                <p>For established legacy handloom companies aiming for unmatched global e-commerce and retail monopoly.</p>
                <ul class="service-list" style="margin-bottom: 40px;">
                    <li>Complete Bespoke Enterprise Scaling</li>
                    <li>Full Varanasi Cinematic Ad Production</li>
                    <li>Omnichannel SEO & Organic Domination</li>
                    <li>Daily Strategy and 24/7 Priority Support</li>
                </ul>
                <div style="text-align: center; position: absolute; bottom: 40px; left: 0; width: 100%; padding: 0 40px;">
                    <a href="/book-now" class="btn-reserve" style="width: 100%;">APPLY TO TIER 3</a>
                </div>
            </div>
        </div>

        <!-- CTA Section -->
        <section class="page-cta reveal">
            <div class="cta-inner" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 80px 40px; border-radius: 40px;">
                <h2>Let's weave your digital success.</h2>
                <p style="margin-bottom: 40px;">Connect with our strategic architects to claim your custom assessment map.</p>
                <a href="/book-now" class="btn-reserve">Start Your Journey Now</a>
            </div>
        </section>
    </div>
</main>

<%- include('partials/footer') %>

<style>
    .page-main-title {
        font-size: clamp(48px, 6vw, 90px);
        font-weight: 300;
        margin-bottom: 30px;
        line-height: 1.1;
    }

    .page-intro {
        max-width: 800px;
        color: rgba(255, 255, 255, 0.6);
        font-size: 19px;
        line-height: 1.6;
        margin-bottom: 80px;
    }

    .detailed-service-row {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 80px;
        padding: 100px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        align-items: center;
    }

    .detailed-service-row.reverse {
        grid-template-columns: 1fr 1.2fr;
    }

    .detailed-service-row.reverse .service-info {
        order: 2;
    }

    .service-index {
        font-family: 'Outfit', sans-serif;
        font-size: 14px;
        color: var(--accent-gold);
        display: block;
        margin-bottom: 20px;
        letter-spacing: 0.3em;
        font-weight: 600;
    }

    .service-info h2 {
        font-size: 42px;
        font-weight: 400;
        margin-bottom: 10px;
        color: white;
        font-family: 'Outfit', sans-serif;
    }

    .service-info h3 {
        font-size: 16px;
        font-weight: 300;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--accent-gold);
        margin-bottom: 30px;
        opacity: 0.9;
    }

    .service-info p {
        font-size: 17px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.55);
        margin-bottom: 40px;
    }

    .luxury-check-list {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .luxury-check-list li {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .luxury-check-list li::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent-gold);
        display: block;
    }

    .glass-box {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 40px;
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .stat-circle {
        font-size: 80px;
        font-weight: 600;
        color: white;
        font-family: 'Outfit', sans-serif;
    }

    .stat-desc {
        color: var(--accent-gold);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        margin-top: 20px;
    }

    .video-placeholder {
        background: linear-gradient(45deg, rgba(24, 5, 8, 0.5), rgba(166, 141, 106, 0.03));
    }

    .page-cta {
        padding: 120px 0;
        text-align: center;
    }

    .cta-inner h2 {
        font-size: 52px;
        margin-bottom: 20px;
        font-weight: 300;
        font-family: 'Outfit', sans-serif;
    }

    .cta-inner p {
        font-size: 18px;
        color: rgba(255, 255, 255, 0.5);
        margin-bottom: 50px;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 40px;
    }

    .service-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: 50px 40px 140px 40px;
        border-radius: 40px;
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
        text-align: left;
    }

    @media (max-width: 992px) {
        .detailed-service-row, .detailed-service-row.reverse {
            grid-template-columns: 1fr;
            gap: 40px;
            padding: 60px 0;
        }

        .detailed-service-row.reverse .service-info {
            order: 0;
        }

        .luxury-check-list {
            grid-template-columns: 1fr;
        }

        .glass-box {
            height: 300px;
        }
    }
</style>
