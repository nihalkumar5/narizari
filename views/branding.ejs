<%- include('partials/header') %>

<main class="section-padding">
    <div class="container">
        
        <!-- Header Section -->
        <div class="reveal" style="text-align: center; margin-bottom: 80px;">
            <p class="hero-tagline">• CINEMATIC BRANDING & STORYTELLING</p>
            <h1 class="page-main-title">Creative <span class="masked">Couture & Branding</span></h1>
            <div class="page-intro" style="margin-left: auto; margin-right: auto; text-align: center; max-width: 800px;">
                <p>We treat your brand's heritage assets as masterpieces. Our team captures the visual soul of your handloom creations right where they are born.</p>
            </div>
        </div>

        <!-- Detailed Description Row -->
        <section class="reveal" style="margin-bottom: 100px;">
            <div class="detailed-service-row" style="border-bottom: none; padding: 0; gap: 80px; align-items: center;">
                <div class="service-info">
                    <span class="service-index">03</span>
                    <h2 style="font-size: 32px; font-weight: 300; margin-bottom: 20px; color: white; font-family: 'Outfit', sans-serif;">Heritage Narrative Weaving</h2>
                    <p style="font-size: 17px; line-height: 1.6; color: rgba(255, 255, 255, 0.8); margin-bottom: 25px;">
                        Every hand-woven Banarasi saree contains centuries of dedicated heritage. We capture this beautiful story through editorial photoshoots and high-end cinematic films directed on location in Varanasi. We highlight the details, the weavers, and the cultural integrity of your collection.
                    </p>
                    <ul class="luxury-check-list" style="margin-top: 30px; margin-bottom: 30px;">
                        <li>Varanasi Ghat Film Production</li>
                        <li>High-Fashion Editorial Shoots</li>
                        <li>Logo DNA & Brand Core Elements</li>
                        <li>Premium Unboxing Box Designs</li>
                    </ul>
                </div>
                <div class="service-visual" style="display: flex; align-items: center; justify-content: center;">
                    <div class="glass-box video-placeholder" style="padding: 60px 45px; text-align: center; background: linear-gradient(45deg, rgba(24, 5, 8, 0.5), rgba(166, 141, 106, 0.03)); border-radius: 40px; height: auto; border: 1px solid rgba(166, 141, 106, 0.15); width: 100%;">
                        <span class="option-icon" style="font-size: 64px;">🎬</span>
                        <h4 style="font-size: 20px; color: white; margin-top: 20px; text-transform: uppercase; letter-spacing: 0.1em; font-family: 'Outfit', sans-serif;">Heritage Stories</h4>
                        <p style="font-size: 13px; color: rgba(255,255,255,0.4); margin-top: 10px; line-height: 1.6;">Capturing the absolute soul and artistry of Banarasi handloom masters.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Detailed Marketing Tactics -->
        <section class="reveal" style="margin-bottom: 120px;">
            <div style="text-align: center; margin-bottom: 60px;">
                <span class="section-label">• CREATIVE DNA •</span>
                <h2 class="section-title" style="margin-top: 15px;">Establishing Cinematic Dominance</h2>
            </div>

            <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
                
                <!-- Card 1 -->
                <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 01</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Cinematic Ghat Film Production</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                        Our creative team coordinates and shoots high-end editorial videos along Varanasi's historic ghats and handloom workshops. We show the emotional depth, ancient looms, and meticulous care behind every silk thread.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 02</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Premium Packaging Design</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                        The luxury buyer's experience starts at the mailbox. We design bespoke, premium unboxing boxes, silk storage wraps, and handwritten artisan notes that elevate delivery into a highly emotional branding moment.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">PILLAR 03</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Visual Identity DNA</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                        We build distinct color scales, elegant minimalist logo marks, and premium typography guidelines that represent your heritage saree brand with maximum authority and aesthetic excellence.
                    </p>
                </div>

            </div>
        </section>

        <!-- CTA Section -->
        <section class="page-cta reveal">
            <div class="cta-inner" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 80px 40px; border-radius: 40px;">
                <h2>Let’s tell your brand's heritage story.</h2>
                <p style="margin-bottom: 40px; color: var(--text-secondary);">We are ready to align with your creative vision. Connect with us for a design strategy review.</p>
                <a href="/book-now" class="btn-reserve">Start Your Branding Now</a>
            </div>
        </section>

    </div>
</main>

<%- include('partials/footer') %>
