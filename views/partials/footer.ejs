    <!-- Footer Hover Effect Script -->
    <script>
    (function() {
        const svg = document.getElementById('nz-footer-svg');
        if (!svg) return;

        const fillText = document.getElementById('nz-fill-text');
        const spotlightRect = svg.querySelector('.nz-spotlight-rect');
        const gradient = document.getElementById('nz-hover-gradient');

        let rafId = null;
        let currentX = 450, currentY = 60;
        let targetX = 450, targetY = 60;
        let isHovering = false;
        let opacity = 0.15;

        function lerp(a, b, t) { return a + (b - a) * t; }

        function animate() {
            currentX = lerp(currentX, targetX, 0.08);
            currentY = lerp(currentY, targetY, 0.08);

            if (gradient) {
                gradient.setAttribute('cx', currentX);
                gradient.setAttribute('cy', currentY);
                gradient.setAttribute('r', 200);
            }

            if (isHovering) {
                opacity = Math.min(1, opacity + 0.05);
            } else {
                opacity = Math.max(0.15, opacity - 0.03);
            }

            if (spotlightRect) spotlightRect.setAttribute('opacity', opacity);
            if (fillText) {
                const strokeOpacity = 0.12 + opacity * 0.5;
                fillText.setAttribute('stroke', `rgba(166,141,106,${strokeOpacity})`);
            }

            rafId = requestAnimationFrame(animate);
        }

        svg.addEventListener('mousemove', function(e) {
            isHovering = true;
            const rect = svg.getBoundingClientRect();
            const svgW = svg.viewBox.baseVal.width || 900;
            const svgH = svg.viewBox.baseVal.height || 120;
            targetX = ((e.clientX - rect.left) / rect.width) * svgW;
            targetY = ((e.clientY - rect.top) / rect.height) * svgH;
        });

        svg.addEventListener('mouseleave', function() {
            isHovering = false;
        });

        svg.addEventListener('mouseenter', function() {
            isHovering = true;
        });

        animate();
    })();
    </script>
