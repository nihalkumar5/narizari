<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Narizari | Luxury Varanasi Silk AI Agency</title>
    <meta name="description" content="Official Varanasi Silk AI Marketing Agency. Weaving tradition with cutting-edge digital intelligence.">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100;300;400;600;800&family=Great+Vibes&family=Inter:wght@100;200;400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/anatomy.css">
    <style>
    /* Premium Right-Aligned Dropdown overrides to prevent screen clipping next to hamburger */
    .nav-dropdown-right .dropdown-content {
        left: auto !important;
        right: 0 !important;
        transform: translateX(0) translateY(15px) !important;
        min-width: 200px !important;
        background: rgba(27, 5, 9, 0.98) !important;
        border: 1px solid rgba(212, 175, 55, 0.25) !important;
    }
    .nav-dropdown-right:hover .dropdown-content {
        transform: translateX(0) translateY(0) !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
    }
    </style>
</head>

<body class="<%= (typeof path === 'undefined' || path === '/') ? 'anatomy-homepage' : '' %>">

    <div class="bg-gradient"></div>
    <div class="bg-noise"></div>

    <nav id="main-nav">
        <div class="nav-container">
            <div class="nav-logo-wrapper">
                <a href="/" class="logo-link">
                    <img src="/assets/logo.png" alt="Narizari" class="brand-logo">
                </a>
            </div>

            <div class="nav-links-wrapper">
                <div class="nav-dropdown">
                    <a href="/services" class="dropdown-trigger">SERVICES <span class="arrow" style="font-size: 8px; margin-left: 2px;">▼</span></a>
                    <div class="dropdown-content">
                        <a href="/shopify-service">🛒 Shopify Plus Build</a>
                        <a href="/ecommerce-marketing">🛍️ eCommerce & Marketing</a>
                        <a href="/digital-marketing">📈 Intelligent Marketing</a>
                        <a href="/branding">🎬 Creative Couture</a>
                    </div>
                </div>
                <a href="/industries">SECTORS</a>
                <a href="/shop-sample" style="color: var(--accent-gold) !important; font-weight: 600; opacity: 1 !important;">SHOP SAMPLE</a>
                <a href="/agency">AGENCY</a>
                <a href="/about">ABOUT</a>
                <a href="/our-team">ARCHITECTS</a>
            </div>

            <div class="nav-actions-wrapper">
                <div class="nav-dropdown nav-dropdown-right">
                    <a href="#" class="btn-reserve dropdown-trigger" style="gap: 5px;">JOIN US <span class="arrow" style="font-size: 8px;">▼</span></a>
                    <div class="dropdown-content">
                        <a href="/connect?type=manufacturer">🏭 Manufacturer</a>
                        <a href="/connect?type=wholesaler">🏛️ Wholesaler</a>
                    </div>
                </div>
                <button class="hamburger" id="menu-toggle">
                    <span class="line-1"></span>
                    <span class="line-2"></span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Full Page Menu Overlay (35% Side Drawer on Desktop) -->
    <div class="menu-overlay" id="menuOverlay">
        <div class="menu-content">
            <button class="menu-close-btn" id="menuClose">
                <div class="close-icon">
                    <span></span>
                    <span></span>
                </div>
                CLOSE
            </button>
            <ul class="menu-list">
                <li><a href="/services" data-text="Strategic Solutions">SERVICES</a></li>
                <li><a href="/shopify-service" data-text="Shopify Plus Build">SHOPIFY SERVICE</a></li>
                <li><a href="/shop-sample" data-text="Shop Sample" style="color: var(--accent-gold) !important;">SHOP SAMPLE</a></li>
                <li><a href="/industries" data-text="Market Expertise">INDUSTRIES</a></li>
                <li><a href="/agency" data-text="The Laboratory">AGENCY</a></li>
                <li><a href="/about" data-text="At home, with us">ABOUT</a></li>
                <li><a href="/our-team" data-text="The Architects">OUR TEAM</a></li>
                <li><a href="/blogs" data-text="Silk Insights">BLOGS</a></li>
                <li><a href="/careers" data-text="Join Us">CAREERS</a></li>
                <li><a href="/connect" data-text="Start Now">CONNECT</a></li>
            </ul>
        </div>
    </div>
