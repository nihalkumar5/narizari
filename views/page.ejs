<%- include('partials/header') %>

<main class="anatomy-main">
    
    <!-- 1. COMMON HEADER (Dark) -->
    <section class="section-anatomy" style="padding-top: 160px; padding-bottom: 80px;">
        <div class="container-anatomy">
            <div class="reveal" style="text-align: center; margin-bottom: 40px;">
                <p class="section-label-anatomy">• <%= pageTitle.toUpperCase() %></p>
                <h1 class="section-title-anatomy" style="font-size: clamp(38px, 5vw, 76px); margin-top: 15px;"><%= pageHeadline %></h1>
                <p class="section-subtitle-anatomy" style="margin-left: auto; margin-right: auto; text-align: center; max-width: 800px; font-size: 18px; margin-top: 25px;">
                    <%= pageDescription %>
                </p>
            </div>
        </div>
    </section>

    <!-- DYNAMIC CONTENT SECTIONS BY ROUTE PATH -->

    <!-- ==================== 1. INDUSTRIES & SECTORS PAGE ==================== -->
    <% if (path === '/industries') { %>
        
        <!-- Industries Grid Section (Light) -->
        <section class="section-anatomy section-light-anatomy reveal">
            <div class="container-anatomy">
                <div class="industry-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
                    
                    <!-- Card 1 -->
                    <div class="glass-panel-anatomy industry-card" style="padding: 40px; border-radius: 24px; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <span class="industry-tag" style="color: var(--accent-gold); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 15px;">Heritage Scale</span>
                            <h3 style="font-family: var(--font-serif); font-size: 24px; font-weight: 300; margin-bottom: 20px; color: white;">Varanasi Handlooms & Heritage Cooperatives</h3>
                            <p style="font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin-bottom: 25px;">We work directly with generation-old weaving families and local cooperatives in Varanasi to establish direct global retail pathways, skipping middlemen and retaining premium profit margins for the artisans.</p>
                        </div>
                        <ul class="industry-bullets" style="list-style: none; padding: 0;">
                            <li style="font-size: 13px; color: var(--text-dim); margin-bottom: 10px; display: flex; align-items: center; gap: 10px;"><span style="color: var(--accent-gold);">•</span> Direct-to-Consumer (D2C) Launch blueprints</li>
                            <li style="font-size: 13px; color: var(--text-dim); margin-bottom: 10px; display: flex; align-items: center; gap: 10px;"><span style="color: var(--accent-gold);">•</span> Legacy Storytelling & Artisan Showcasing</li>
                            <li style="font-size: 13px; color: var(--text-dim); margin-bottom: 10px; display: flex; align-items: center; gap: 10px;"><span style="color: var(--accent-gold);">•</span> Fair-Trade Collective Branding Funnels</li>
                        </ul>
                    </div>

                    <!-- Card 2 -->
                    <div class="glass-panel-anatomy industry-card" style="padding: 40px; border-radius: 24px; display: flex; flex-direction: column; justify-content: space-between; border-color: var(--accent-gold); box-shadow: 0 0 25px rgba(166, 141, 106, 0.25);">
