<%- include('partials/header') %>

<main class="anatomy-main">
    
    <!-- 1. HEADER SECTION (Dark) -->
    <section class="section-anatomy" style="padding-top: 160px; padding-bottom: 80px;">
        <div class="container-anatomy">
            <div class="reveal" style="text-align: center; margin-bottom: 40px;">
                <span class="section-label-anatomy">• HIGH-ROAS PERFORMANCE</span>
                <h1 class="section-title-anatomy" style="font-size: clamp(38px, 5vw, 76px); margin-top: 15px;">Intelligent <span class="masked">Digital Marketing</span></h1>
                <p class="section-subtitle-anatomy" style="margin-left: auto; margin-right: auto; text-align: center; max-width: 800px; font-size: 18px; margin-top: 25px;">
                    We connect luxury heritage looms and boutique designers with premium buyers across the globe using proprietary audience targeting models.
                </p>
            </div>
        </div>
    </section>

    <!-- 2. PRECISION AUDIENCE TARGETING (Light) -->
    <section class="section-anatomy section-light-anatomy reveal">
        <div class="container-anatomy">
            <div class="detailed-service-row" style="border-bottom: none; padding: 0; gap: 80px; align-items: center;">
                <div class="service-info">
                    <span class="service-index">02</span>
                    <h2 class="section-title-anatomy" style="font-size: 32px;">Precision Audience Targeting</h2>
                    <p style="font-size: 17px; line-height: 1.6; margin-bottom: 25px;">
                        Our marketing campaigns target the high-ticket bridal and festive ethnicwear markets with extreme accuracy. By utilizing advanced custom cohort modeling, we pinpoint premium NRI and domestic buyers who are ready to purchase luxury sarees.
                    </p>
                    <ul class="luxury-check-list" style="margin-top: 30px; margin-bottom: 30px;">
                        <li>AI-Driven Social & Search Campaigns</li>
                        <li>High-Value Bridal & Festive Audiences</li>
                        <li>Automated VIP WhatsApp Funnels</li>
                        <li>Omnichannel Retargeting Systems</li>
                    </ul>
                </div>
                <div class="service-visual" style="display: flex; align-items: center; justify-content: center;">
                    <div class="glass-panel-anatomy glass-box" style="padding: 60px 45px; text-align: center; height: auto; width: 100%;">
                        <div class="stat-circle" style="color: var(--accent-gold); font-size: 88px; font-weight: 600; font-family: 'Outfit', sans-serif;">12x+</div>
                        <p class="stat-desc" style="font-size: 12px; letter-spacing: 0.15em; color: white; text-transform: uppercase; margin-top: 20px;">Average Return on Advertising (ROAS)</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. TACTICAL ADVANTAGES (Dark) -->
    <section class="section-anatomy" style="background-color: rgba(24, 5, 8, 0.15);">
        <div class="container-anatomy">
            <div style="text-align: center; margin-bottom: 60px;">
                <span class="section-label-anatomy">• TACTICAL ADVANTAGES •</span>
                <h2 class="section-title-anatomy" style="margin-top: 15px;">We Stop Wasting Your Ad Spend</h2>
            </div>

            <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
                
                <!-- Card 1 -->
                <div class="glass-panel-anatomy service-card" style="padding: 45px 35px; border-radius: 30px; height: auto;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; color: var(--accent-gold); font-weight: 600; display: block;">ADVANTAGE 01</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3; font-family: 'Outfit', sans-serif;">Targeted Ad Spend</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin: 0;">
                        No spraying and praying. We build custom algorithmic models based on historical NRI purchasing behaviors to ensure your ads are shown strictly to high-income, high-intent buyers in Silicon Valley, London, and Dubai.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="glass-panel-anatomy service-card" style="padding: 45px 35px; border-radius: 30px; height: auto;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; color: var(--accent-gold); font-weight: 600; display: block;">ADVANTAGE 02</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3; font-family: 'Outfit', sans-serif;">Omnichannel Retention</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin: 0;">
                        We combine precision email newsletters with high-converting automated SMS and WhatsApp prompts. By engaging prospects directly on their preferred chat screens, we achieve cart recovery rates of up to 34%.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="glass-panel-anatomy service-card" style="padding: 45px 35px; border-radius: 30px; height: auto;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; color: var(--accent-gold); font-weight: 600; display: block;">ADVANTAGE 03</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3; font-family: 'Outfit', sans-serif;">Verified 12x+ ROAS</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin: 0;">
                        Our statistics don't lie. By targeting premium audiences and optimization of visual funnel checkouts, our clients experience an average of 12-times return on their paid campaign investments.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- 4. CTA SECTION (Light) -->
    <section class="section-anatomy section-light-anatomy reveal">
        <div class="container-anatomy">
            <div class="cta-inner" style="background: rgba(36, 9, 13, 0.95); border: 1px solid rgba(166,141,106,0.25); padding: 80px 40px; border-radius: 40px; text-align: center; box-shadow: 0 15px 40px rgba(36, 9, 13, 0.15);">
                <h2 style="font-size: clamp(28px, 4vw, 52px); margin-bottom: 20px; font-weight: 300; font-family: var(--font-serif); color: white;">Ready to launch campaigns?</h2>
                <p style="margin-bottom: 40px; color: rgba(255,255,255,0.7); font-size: 17px;">Secure your complimentary strategy session to unlock a 12x ROAS blueprint today.</p>
                <a href="/book-now" class="btn-anatomy-primary">Claim Your Strategy Now</a>
            </div>
        </div>
    </section>

</main>

<%- include('partials/footer') %>
