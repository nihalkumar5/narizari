<%- include('partials/header') %>

<main class="section-padding">
    <div class="container">
        
        <!-- Header Section -->
        <div class="reveal" style="text-align: center; margin-bottom: 80px;">
            <p class="hero-tagline">• HIGH-ROAS PERFORMANCE</p>
            <h1 class="page-main-title">Intelligent <span class="masked">Digital Marketing</span></h1>
            <div class="page-intro" style="margin-left: auto; margin-right: auto; text-align: center; max-width: 800px;">
                <p>We connect luxury heritage looms and boutique designers with premium buyers across the globe using proprietary audience targeting models.</p>
            </div>
        </div>

        <!-- Detailed Description Row -->
        <section class="reveal" style="margin-bottom: 100px;">
            <div class="detailed-service-row" style="border-bottom: none; padding: 0; gap: 80px; align-items: center;">
                <div class="service-info">
                    <span class="service-index">02</span>
                    <h2 style="font-size: 32px; font-weight: 300; margin-bottom: 20px; color: white; font-family: 'Outfit', sans-serif;">Precision Audience Targeting</h2>
                    <p style="font-size: 17px; line-height: 1.6; color: rgba(255, 255, 255, 0.8); margin-bottom: 25px;">
                        Our marketing campaigns target the high-ticket bridal and festive ethnicwear markets with extreme accuracy. By utilizing advanced custom cohort modeling, we pinpoint premium NRI and domestic buyers who are ready to purchase luxury sarees.
                    </p>
                    <ul class="luxury-check-list" style="margin-top: 30px; margin-bottom: 30px;">
                        <li>AI-Driven Social & Search Campaigns</li>
                        <li>High-Value Bridal & Festive Audiences</li>
                        <li>Automated VIP WhatsApp Funnels</li>
                        <li>Omnichannel Retargeting Systems</li>
                    </ul>
                </div>
                <div class="service-visual" style="display: flex; align-items: center; justify-content: center;">
                    <div class="glass-box" style="padding: 60px 45px; text-align: center; background: radial-gradient(circle, rgba(166,141,106,0.06) 0%, rgba(24,5,8,0.2) 100%); border-radius: 40px; height: auto; border: 1px solid rgba(166,141,106,0.15); width: 100%;">
                        <div class="stat-circle" style="color: var(--accent-gold); font-size: 88px; font-weight: 600; font-family: 'Outfit', sans-serif;">12x+</div>
                        <p class="stat-desc" style="font-size: 12px; letter-spacing: 0.15em; color: white; text-transform: uppercase; margin-top: 20px;">Average Return on Advertising (ROAS)</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Detailed Marketing Tactics -->
        <section class="reveal" style="margin-bottom: 120px;">
            <div style="text-align: center; margin-bottom: 60px;">
                <span class="section-label">• TACTICAL ADVANTAGES •</span>
                <h2 class="section-title" style="margin-top: 15px;">We Stop Wasting Your Ad Spend</h2>
            </div>

            <div class="services-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
                
                <!-- Card 1 -->
                <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">ADVANTAGE 01</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Targeted Ad Spend</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                        No spraying and praying. We build custom algorithmic models based on historical NRI purchasing behaviors to ensure your ads are shown strictly to high-income, high-intent buyers in Silicon Valley, London, and Dubai.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">ADVANTAGE 02</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Omnichannel Retention</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                        We combine precision email newsletters with high-converting automated SMS and WhatsApp prompts. By engaging prospects directly on their preferred chat screens, we achieve cart recovery rates of up to 34%.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="service-card" style="padding: 45px 35px; border-radius: 30px; background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); height: auto; transition: all 0.4s ease;">
                    <span class="service-no" style="font-size: 11px; margin-bottom: 20px; opacity: 0.6;">ADVANTAGE 03</span>
                    <h3 style="font-size: 20px; font-weight: 400; margin-bottom: 15px; color: white; line-height: 1.3;">Verified 12x+ ROAS</h3>
                    <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 0;">
                        Our statistics don't lie. By targeting premium audiences and optimization of visual funnel checkouts, our clients experience an average of 12-times return on their paid campaign investments.
                    </p>
                </div>

            </div>
        </section>

        <!-- CTA Section -->
        <section class="page-cta reveal">
            <div class="cta-inner" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 80px 40px; border-radius: 40px;">
                <h2>Ready to launch high-performance campaigns?</h2>
                <p style="margin-bottom: 40px; color: var(--text-secondary);">Secure your complimentary strategy session to unlock a 12x ROAS blueprint today.</p>
                <a href="/book-now" class="btn-reserve">Claim Your Strategy Now</a>
            </div>
        </section>

    </div>
</main>

<%- include('partials/footer') %>
